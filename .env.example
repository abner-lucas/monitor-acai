# Banco MySQL da Hostinger.
# No servidor da Hostinger use DB_HOST=127.0.0.1 (o banco roda na mesma máquina).
# Para rodar localmente, use o host remoto (srvNNNN.hstgr.io) e libere seu IP em
# hPanel > Bancos de dados > MySQL remoto.
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME=""
DB_USER=""
DB_PASSWORD=""

# Segredo que assina o cookie de sessão (mínimo de 32 caracteres aleatórios).
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""
